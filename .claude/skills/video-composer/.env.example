# Video Composer Configuration

# Whisper Model (tiny, base, small, medium, large)
WHISPER_MODEL=base

# FFmpeg Path (leave empty to use system PATH)
FFMPEG_PATH=

# Output Settings
DEFAULT_OUTPUT_DIR=output
VIDEO_CODEC=libx264
AUDIO_CODEC=aac

# Subtitle Settings
SUBTITLE_FONT=Arial
SUBTITLE_SIZE=24
SUBTITLE_COLOR=white
SUBTITLE_OUTLINE_COLOR=black

# Transition Settings
FADE_DURATION=1.0
