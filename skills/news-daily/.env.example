# GitHub 仓库配置（可选，用于自动发布日报）
# 配置后，日报会自动提交到指定仓库

# GitHub 仓库 URL（支持 HTTPS 和 SSH 格式）
# 例如: https://github.com/username/repo.git 或 git@github.com:username/repo.git
# 注意：请确保本地已配置好 git 用户信息和认证方式
GITHUB_REPO_URL=

# 仓库类型（可选，留空则自动检测）
# 支持的类型: vuepress, generic, custom
# - vuepress: 写入到 docs/ 目录（适用于 VuePress 博客）
# - generic: 写入到仓库根目录（默认）
# - custom: 写入到自定义目录（需要配置 REPO_TARGET_DIR）
REPO_TYPE=

# 目标目录（仅当 REPO_TYPE=custom 时需要）
# 相对于仓库根目录的路径，例如: posts/daily-news
REPO_TARGET_DIR=

# 日报文件名格式（支持日期占位符）
# %Y: 年份, %m: 月份, %d: 日期
# 默认: daily-news-%Y%m%d.md
FILENAME_FORMAT=daily-news-%Y%m%d.md
